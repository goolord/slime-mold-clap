{
    "CmajorVersion":    1,
    "ID":               "dev.goolord.slimemold",
    "version":          "0.1",
    "name":             "Slimemold",
    "description":      "A feedback delay network reverb whose matrix grows like a slime mould",
    "category":         "effect",
    "manufacturer":     "goolord",
    "isInstrument":     false,

    "plugin":
    {
        "manufacturerCode":  "Gool",
        "pluginCode":        "Slim"
    },

    "source":           [ "dsp/Params.cmajor", "dsp/PhysarumFdn.cmajor", "dsp/Plugin.cmajor", "dsp/lib/Common.cmajor", "dsp/lib/Utility.cmajor" ],
    "worker":           "bundle/worker.js",
    "resources":        [ "bundle/factory-presets.json" ],

    "view":
    {
        "src":       "bundle/view.js",
        "width":     1000,
        "height":    560,
        "resizable": true
    }
}
